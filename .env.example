# Both values come from the Supabase dashboard:
#   Project Settings -> API Keys   (older projects: Settings -> API)
#
# The Project URL is always https://<project-ref>.supabase.co, and the project
# ref is the last segment of the dashboard URL in your address bar.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ward slug for the public bulletin route /p/<slug>/program
NEXT_PUBLIC_WARD_SLUG=oak-hills

# Deliberately absent: SUPABASE_SERVICE_ROLE_KEY.
# It bypasses row level security entirely and nothing in wardOS needs it.
# Its absence is what closes known defect 16 — do not add it back "just in case".
#
# Also absent: the database password. That is for the Supabase CLI, not the app.
